{
    "name": "eastpointlabs/laravel-au",
    "description": "Australian business and address helpers for Laravel and Filament: ABN/ACN validation, ABN Lookup, phone numbers, postcodes and BSBs.",
    "keywords": [
        "laravel",
        "filament",
        "australia",
        "abn",
        "acn",
        "abr",
        "abn-lookup",
        "validation",
        "phone",
        "postcode",
        "bsb"
    ],
    "homepage": "https://github.com/Luke-Johnstone/laravel-au",
    "license": "MIT",
    "authors": [
        {
            "name": "Luke Johnstone",
            "email": "luke@eastpointlabs.com.au",
            "homepage": "https://eastpointlabs.com.au",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Luke-Johnstone/laravel-au/issues",
        "source": "https://github.com/Luke-Johnstone/laravel-au",
        "security": "https://github.com/Luke-Johnstone/laravel-au/security/policy"
    },
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filament/filament": "^4.0|^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "fakerphp/faker": "Required for the Faker provider (^1.23).",
        "filament/filament": "Required for the optional Filament form fields (^4.0|^5.0)."
    },
    "autoload": {
        "psr-4": {
            "EastpointLabs\\LaravelAu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EastpointLabs\\LaravelAu\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "build": "Build the demo app's database and assets.",
        "serve": "Run the demo app (Filament panel at /admin).",
        "test": "Run the Pest test suite.",
        "analyse": "Run PHPStan (Larastan) static analysis.",
        "format": "Fix code style with Laravel Pint.",
        "lint": "Check code style without changing files.",
        "check": "Quality gate: lint, static analysis and tests."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EastpointLabs\\LaravelAu\\LaravelAuServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
